{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C#: SampleHost Debug",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/samples/ToastUIImageEditor.Blazor.SampleHost/bin/Debug/net10.0/ToastUIImageEditor.Blazor.SampleHost.dll",
      "cwd": "${workspaceFolder}/samples/ToastUIImageEditor.Blazor.SampleHost",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development"
      },
      "preLaunchTask": "build: SampleHost",
      "console": "integratedTerminal",
      "checkForDevCert": true
    },
    {
      "name": "C#: SampleHost Watch",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "watch",
        "--project",
        "${workspaceFolder}/samples/ToastUIImageEditor.Blazor.SampleHost"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development"
      },
      "console": "integratedTerminal",
      "checkForDevCert": true
    }
  ]
}
